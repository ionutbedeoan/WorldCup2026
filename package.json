{
  "name": "world-cup-predictor",
  "version": "1.0.0",
  "description": "World Cup Predictor Game built with Node.js, React, Tailwind CSS, TypeScript, and Supabase",
  "main": "dist-server/server.js",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build:client": "vite build",
    "build:server": "tsc server.ts --outDir dist-server --module esnext --moduleResolution node --target es2020 --esModuleInterop --allowSyntheticDefaultImports",
    "build": "npm run build:client && npm run build:server",
    "start": "cross-env NODE_ENV=production node dist-server/server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
